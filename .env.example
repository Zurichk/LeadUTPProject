# Copia este archivo a `.env` y ajusta los valores.
# Todas las variables usan el prefijo LECTURA_.
# Referencia completa: docs/guiadeservicios.md

# ---------------------------------------------------------------- general
LECTURA_ENVIRONMENT=local
LECTURA_LOG_LEVEL=INFO

# Modo demostración: OCR simulado, voz en el navegador y almacenamiento en
# memoria. Útil para probar la interfaz sin crear recursos en Azure.
LECTURA_DEMO_MODE=true

# ------------------------------------------------------------------- OCR
# Proveedor: "vision" (Azure AI Vision) o "document_intelligence".
LECTURA_OCR_PROVIDER=vision
LECTURA_VISION_ENDPOINT=https://cog-lecturafacil-vision-MISUFIXO.cognitiveservices.azure.com/
# Solo en local (en Azure se usa la Managed Identity):
# LECTURA_VISION_KEY=
# LECTURA_DOCUMENT_INTELLIGENCE_ENDPOINT=https://cog-lecturafacil-di-MISUFIXO.cognitiveservices.azure.com/
# LECTURA_DOCUMENT_INTELLIGENCE_KEY=
LECTURA_MIN_OCR_CONFIDENCE=0.5

# ---------------------------------------------------------- almacenamiento
# En Azure (Managed Identity):
LECTURA_BLOB_SERVICE_URL=https://leadutpproject.blob.core.windows.net/
LECTURA_BLOB_CONTAINER=fichas-lectura
# En local puedes usar la cadena de conexión en su lugar:
# LECTURA_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
LECTURA_PROFILES_BLOB_NAME=perfiles.json

# ------------------------------------------------------------------- voz
# Modo de voz: auto (intenta Azure y cae al navegador) | browser | azure.
# En Azure for Students NO hay Azure AI Speech -> usa "browser".
LECTURA_SPEECH_BACKEND=browser
# Solo si Azure AI Speech estuviera disponible:
# LECTURA_SPEECH_REGION=westus2
# Solo para desarrollo local; en Azure no hace falta (usa Managed Identity).
# LECTURA_SPEECH_KEY=
# LECTURA_SPEECH_VOICES__ES=es-ES-ElviraNeural
# LECTURA_SPEECH_VOICES__CA=ca-ES-JoanaNeural

# --------------------------------------------------- traducción (Foundry)
# OJO: el endpoint de inferencia es el .openai.azure.com, NO el
# services.ai.azure.com del proyecto (ese da timeout).
LECTURA_TRANSLATION_ENABLED=true
LECTURA_FOUNDRY_ENDPOINT=https://cog-lecturafacil-vision-mika01.openai.azure.com/openai/v1
LECTURA_FOUNDRY_DEPLOYMENT=Phi-4-mini-instruct
# Solo en local; en Azure usa la Managed Identity (deja vacío).
# LECTURA_FOUNDRY_API_KEY=
LECTURA_FOUNDRY_TIMEOUT_SECONDS=25
LECTURA_TRANSLATION_CACHE_SIZE=512

# -------------------------------------------------------------- aplicación
LECTURA_DEFAULT_LANGUAGE=es
LECTURA_DEFAULT_MAX_WORDS=12
LECTURA_MAX_UPLOAD_MB=12
LECTURA_MATCH_THRESHOLD=0.8